# ---------- Node.js / dependencies ----------
node_modules/

# ---------- Build artifacts ----------
dist/
src-tauri/target/

# ---------- Markdown docs policy ----------
# Public docs are only the two READMEs. Other Markdown (internal notes, drafts)
# stays local to keep the repository free of unfinished documents.
# To track an extra file, add `!<filename>` below (negate cannot re-include
# files under an ignored directory such as docs/ without unignoring the dir).
*.md
*.MD
!README.md
!README_EN.md

# ---------- Local working documents（不入库）----------
# Convention: docs/reviews/<date>/<date>-vN.md
PRD.md
IMPLEMENTATION_NOTES.md
docs/
.workbuddy/
.release-notes.md

# ---------- Local environment and secrets ----------
.npmrc
.env
.env.local
.env.*.local
*.local.json
config.json

# ---------- Runtime cache / local app data ----------
EBWebView/
AppData/
Roaming/

