{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": ["src"],
  // 测试文件与它的 Node 类型垫片不进应用构建：前者 import 带 .ts 后缀（Vite 侧不需要）、
  // 引用 node: 内置模块；它们由 tsconfig.test.json 单独做类型检查。
  "exclude": ["src/**/*.test.ts", "src/node-shims.d.ts"],
  "references": []
}
