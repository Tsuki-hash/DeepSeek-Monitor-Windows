{
  "name": "deepseek-monitor-windows",
  "version": "1.2.3",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "npm run test:types && npm run test:unit",
    "test:types": "tsc --noEmit -p tsconfig.test.json",
    "test:unit": "node --test --experimental-strip-types \"src/**/*.test.ts\"",
    "lint": "eslint src",
    "verify": "pwsh -NoProfile -File scripts/verify.ps1",
    "check:version": "node scripts/check-version.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:check": "cargo check --manifest-path src-tauri/Cargo.toml --all-targets"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@tauri-apps/cli": "^2.11.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "typescript": "5.6.3",
    "typescript-eslint": "^8.18.0",
    "vite": "5.4.11"
  }
}
